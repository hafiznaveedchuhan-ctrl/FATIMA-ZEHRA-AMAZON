# Backend Services Environment Configuration
# Copy this to .env.backend and fill in your actual values

# DATABASE - Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# JWT Configuration
JWT_SECRET=your-random-32-character-secret-key
JWT_EXPIRATION=24

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here


# Service Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# CORS & Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER=+923002385209
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-id

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your=hnaveed264@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
